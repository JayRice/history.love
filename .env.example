# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real configuration.
#
# Only EXPO_PUBLIC_* variables reach the client bundle. Never put
# secrets (service keys, database credentials) in any Expo env file.

# Backend API base URL. Local development example:
EXPO_PUBLIC_API_URL=http://localhost:5000

# Firebase web API key (public client identifier, not a secret).
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key

# OAuth client ids (optional until OAuth is configured).
EXPO_PUBLIC_WEB_CLIENT_ID=
EXPO_PUBLIC_ANDROID_CLIENT_ID=
