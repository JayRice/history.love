# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit real configuration.
#
# Only EXPO_PUBLIC_* variables reach the client bundle. Never put secrets
# (service-role keys, database passwords) in any Expo env file: the client
# receives ONLY the publishable anon key.

# Local development (supabase start; ports are shifted to 553xx in
# supabase/config.toml):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# The anon/publishable key printed by `npx supabase status`:
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key
